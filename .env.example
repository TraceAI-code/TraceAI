DATABASE_URL=postgresql+psycopg://postgres.example:password@example-host:5432/postgres

# Optional Supabase Storage configuration (for evidence snapshot storage)
# If not provided, evidence will automatically be stored locally in ./data/evidence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key
SUPABASE_STORAGE_BUCKET=traceai-evidence

# Comma-separated browser origins allowed to call the API.
# Use "*" only if you do not need credentialed (cookie-auth) requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173